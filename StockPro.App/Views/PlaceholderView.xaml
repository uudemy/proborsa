<UserControl x:Class="StockPro.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border Width="72"
                    Height="72"
                    CornerRadius="18"
                    Background="{StaticResource SurfaceSecondaryBrush}">

                <TextBlock
                    Text="{Binding Icon}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="30"
                    Foreground="{StaticResource AccentBrush}" />

            </Border>

            <TextBlock
                Text="{Binding Title}"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock
                Text="Bu modül StockPro mimarisine bağlanmaya hazır."
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}" />

            <Border
                Margin="0,24,0,0"
                Padding="12,8"
                HorizontalAlignment="Center"
                Background="{StaticResource SurfaceSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">

                <TextBlock
                    Text="Module Ready"
                    FontSize="11"
                    Foreground="{StaticResource PositiveBrush}" />

            </Border>

        </StackPanel>

    </Grid>

</UserControl>