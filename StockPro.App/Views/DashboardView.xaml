<UserControl x:Class="StockPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StockPro.App.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <converters:BooleanToPositiveBrushConverter
            x:Key="BooleanToPositiveBrushConverter"/>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <StackPanel>

                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock Text="Piyasa genel görünümü ve güncel işlem verileri"
                               Margin="0,5,0,0"
                               Style="{StaticResource SecondaryTextStyle}"/>

                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,7">

                    <TextBlock Text="{Binding MarketStatus}"
                               Foreground="{StaticResource PositiveBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                </Border>

            </Grid>

            <!-- MARKET CARDS -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding MarketCards}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <UniformGrid Columns="4"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,8,0">

                            <StackPanel>

                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource SecondaryTextStyle}"/>

                                <TextBlock Text="{Binding Value}"
                                           Margin="0,8,0,2"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="{Binding Change}"
                                           Foreground="{Binding IsPositive,
                                                Converter={StaticResource BooleanToPositiveBrushConverter}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- MAIN AREA -->
            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CHART -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="300"/>
                        </Grid.RowDefinitions>

                        <!-- CHART HEADER -->
                        <Grid Grid.Row="0">

                            <StackPanel>

                                <TextBlock Text="BIST 100"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Günlük performans"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"/>

                            </StackPanel>

                            <!-- PERIOD BUTTONS -->
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">

                                <!-- 1G -->
                                <Button Content="1G"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="1G"
                                        Margin="0,0,5,0">

                                    <Button.Style>

                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ToolbarButtonStyle}">

                                            <Setter Property="Opacity"
                                                    Value="0.55"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedPeriod}"
                                                             Value="1G">

                                                    <Setter Property="Opacity"
                                                            Value="1"/>

                                                    <Setter Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>

                                                    <Setter Property="Foreground"
                                                            Value="White"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                                <!-- 1H -->
                                <Button Content="1H"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="1H"
                                        Margin="0,0,5,0">

                                    <Button.Style>

                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ToolbarButtonStyle}">

                                            <Setter Property="Opacity"
                                                    Value="0.55"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedPeriod}"
                                                             Value="1H">

                                                    <Setter Property="Opacity"
                                                            Value="1"/>

                                                    <Setter Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>

                                                    <Setter Property="Foreground"
                                                            Value="White"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                                <!-- 1A -->
                                <Button Content="1A"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="1A"
                                        Margin="0,0,5,0">

                                    <Button.Style>

                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ToolbarButtonStyle}">

                                            <Setter Property="Opacity"
                                                    Value="0.55"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedPeriod}"
                                                             Value="1A">

                                                    <Setter Property="Opacity"
                                                            Value="1"/>

                                                    <Setter Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>

                                                    <Setter Property="Foreground"
                                                            Value="White"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                                <!-- 1Y -->
                                <Button Content="1Y"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="1Y">

                                    <Button.Style>

                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ToolbarButtonStyle}">

                                            <Setter Property="Opacity"
                                                    Value="0.55"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedPeriod}"
                                                             Value="1Y">

                                                    <Setter Property="Opacity"
                                                            Value="1"/>

                                                    <Setter Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>

                                                    <Setter Property="Foreground"
                                                            Value="White"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                            </StackPanel>

                        </Grid>

                        <!-- BIST CHART -->
                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                            <Canvas x:Name="BistChartCanvas"
                                    Margin="4"/>

                        </Border>

                    </Grid>

                </Border>

                <!-- RIGHT SIDE -->
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- GAINERS -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorderStyle}">

                        <StackPanel Margin="16">

                            <TextBlock Text="En Çok Yükselenler"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding TopGainers}"
                                          Margin="0,12,0,0">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Symbol}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Price}"
                                                       Margin="15,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Change}"
                                                       Foreground="{StaticResource PositiveBrush}"/>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                    <!-- LOSERS -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardBorderStyle}">

                        <StackPanel Margin="16">

                            <TextBlock Text="En Çok Düşenler"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding TopLosers}"
                                          Margin="0,12,0,0">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Symbol}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Price}"
                                                       Margin="15,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Change}"
                                                       Foreground="{StaticResource NegativeBrush}"/>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

            <!-- WATCHLIST -->
            <Border Grid.Row="6"
                    Style="{StaticResource CardBorderStyle}">

                <StackPanel Margin="18">

                    <TextBlock Text="Piyasa İzleme"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Takip listenizdeki hisseleri buradan izleyebilirsiniz."
                               Margin="0,5,0,15"
                               Style="{StaticResource SecondaryTextStyle}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Sembol"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Fiyat"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="Değişim"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Durum"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>