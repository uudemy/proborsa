<Window x:Class="StockPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockPro.App.Views"
        Title="{Binding Title}"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Logo -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="30"
                            Height="30"
                            CornerRadius="7"
                            Background="{StaticResource AccentBrush}">

                        <TextBlock Text="S"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="StockPro"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Text="Trading Terminal"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                    </StackPanel>

                </StackPanel>


                <!-- Search -->

                <Border Grid.Column="1"
                        Width="420"
                        Height="34"
                        HorizontalAlignment="Center"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">

                    <Grid>

                        <TextBlock Text="⌕"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="Search symbol or command..."
                                   Margin="38,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Border HorizontalAlignment="Right"
                                Margin="0,0,8,0"
                                Padding="6,2"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="4">

                            <TextBlock Text="Ctrl+K"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- Header Buttons -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="◔"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Theme"/>

                    <Button Content="⚙"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Settings"/>

                    <Border Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            CornerRadius="16">

                        <TextBlock Text="SP"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- SIDEBAR -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Navigation -->

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="8,16">

                            <TextBlock Text="NAVIGATION"
                                       Margin="12,0,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>


                            <ItemsControl ItemsSource="{Binding NavigationItems}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button Command="{Binding DataContext.NavigateCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource NavigationButtonStyle}">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Icon}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"/>


                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>

                                            </Grid>

                                        </Button>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>


                    <!-- Connection Status -->

                    <Border Grid.Row="1"
                            Margin="12"
                            Padding="10"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            CornerRadius="6">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{StaticResource PositiveBrush}"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text=" Demo Market Data"
                                           Margin="7,0,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                            </StackPanel>


                            <TextBlock Text="Connected"
                                       Margin="14,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Background="{StaticResource BackgroundBrush}">

                <!--
                Dashboard'ı doğrudan oluşturuyoruz.
                Şu aşamada ContentControl / DataTemplate /
                Visibility trigger kullanmıyoruz.
            -->

                <views:DashboardView/>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- STATUS BAR -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="12,0">

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"/>


                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">

                    <TextBlock Text="Demo Mode"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource WarningBrush}"/>

                    <TextBlock Text="  |  "
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text=".NET 9"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
