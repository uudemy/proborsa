<Window x:Class="StockPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockPro.App.Views"
        Title="StockPro"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <TextBlock Text="StockPro"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="MARKET TERMINAL"
                           Margin="115,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

            </Grid>

        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10,18">

                        <TextBlock Text="WORKSPACE"
                                   Margin="10,0,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="▦   Dashboard"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[0]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="◈   Markets"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[1]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="☆   Watchlist"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[2]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="⌁   Chart"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[3]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="⌕   Scanner"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[4]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <TextBlock Text="TRADING"
                                   Margin="10,22,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="▤   Portfolio"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[5]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="↕   Orders"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[6]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="≡   Trades"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[7]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="⚑   Alerts"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[8]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <TextBlock Text="INFORMATION"
                                   Margin="10,22,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="▰   News"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[9]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="⚙   Settings"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding NavigationItems[10]}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- DASHBOARD TEST AREA -->
            <Grid Grid.Column="1">
                <views:DashboardView/>
            </Grid>

        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="12,0">

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="DEMO MODE"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource WarningBrush}"/>

            </Grid>

        </Border>

    </Grid>

</Window>